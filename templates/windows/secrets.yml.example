---
# Merge into the existing private group_vars/all/secrets.yml, mode 0600 or Vault.
# Both fields are maintained together here, never duplicated in settings.yml.
windows_access:
  user: ''      # Kerberos: user@REALM, matching the AD principal.
  password: ''  # Enter locally. Never send it to the agent or a command line.
windows_host_access: {}  # Optional host-specific account overrides, also secret.
