# ~/.bashrc des Ansible-Controllers
# Alle Funktionen und Aliase werden zentral im Projekt gepflegt.

export ANSIBLE_PROJECT_ROOT="/root/ansible"

if [[ -r "${ANSIBLE_PROJECT_ROOT}/config/shell_aliases.sh" ]]; then
    # shellcheck disable=SC1090
    source "${ANSIBLE_PROJECT_ROOT}/config/shell_aliases.sh"
fi
